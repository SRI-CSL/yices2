#!/bin/sh

#
#  Copyright (c) 2026, SRI International
#  SPDX-License-Identifier: BSD-3-Clause
#

#
# Script to install Yices on Mac OS X
#
# Usage
# -----
#     ./install-yices [OPTIONS] <location>
#
# This script must be called from the toplevel Yices directory.
#
# If <location> is a directory, then Yices is installed as follows:
#     binaries      in <location>/bin
#     libraries     in <location>/lib
#     include files in <location>/include
#     pkg-config    in <location>/lib/pkgconfig/yices.pc
#     legal record  in <location>/share/doc/yices-2.8.0 and
#                   <location>/share/licenses/yices-2.8.0
#
# If no <location> is given, Yices will be installed in /usr/local.
#
# If <location> is the special keyword 'here', or if it is equal to
# the current directory, then no files are copied but symbolic links
# are created in ./lib
#
# OPTIONS:
#  --replace-existing: permit replacement of existing Yices paths
#  -h --help: print a short help message
#

usage="Usage: $0 [OPTIONS] <directory>
    or $0 here

The first form installs Yices in the location specified by <directory>.
This copies binaries, libraries, and header files as follows:

   binaries      in <directory>/bin
   libraries     in <directory>/lib
   include files in <directory>/include
   pkg-config    in <directory>/lib/pkgconfig/yices.pc
   legal record  in <directory>/share/doc/yices-2.8.0 and
                 <directory>/share/licenses/yices-2.8.0

If the <directory> is not given, this script will attempt to install
Yices in the default location, that is, in /usr/local. To use this
option, you typically need

   sudo $0

The second form install yices locally. The script will just create symbolic
links in the ./lib directory.


OPTIONS:
  --replace-existing: permit replacement of existing Yices files and links
  -h --help:  print this message
"

failure="
Installation failed
"


#
# Tools we need: change this if they are not found
#
install="/usr/bin/install"
link="/bin/ln"


#
# Process the command line
#
location_given=no
location=
replace_existing=no

while test -n "$1"; do
  case $1 in
    -h | --help)
        echo "$usage"
        exit 0;;

    --replace-existing)
        replace_existing=yes
        shift
        continue;;

    -*) echo "Unknown option $1. Try $0 -h for help"
        exit 1;;

    *) if test "$location_given" = "yes" ; then
         echo "Please specify a single location. Try $0 -h for help"
         exit 1
       fi
       location_given="yes"
       location=$1
       shift
       continue;;
  esac
done



#
# Check that the current directory contains bin lib include
# subdirectories and check the lib contains libyices.2.dylbib.
#
local_dir=`pwd`
if test -d "$local_dir/bin" -a -d "$local_dir/lib" -a -d "$local_dir/include" ; then

   dylib_file=`ls lib/libyices.2.dylib | sed -e 's+lib/++' 2>/dev/null`

   case "$dylib_file" in
     libyices.2.dylib)
       ;;

     *) echo "$failure"
        echo "Can't find the Yices library libyices.2.dylib in ./lib"
        echo "Make sure $0 is run from the toplevel Yices directory"
	echo ""
        exit 1;;

    esac

else
   echo "$failure"
   echo "Can't find the ./bin ./lib or ./include directory"
   echo "Make sure $0 is run from the toplevel Yices directory"
   echo ""
   exit 1
fi

# The dylib filename contains only the ABI major version, not the full release
# version. Keep this literal synchronized with each Yices release.
version=2.8.0


#
# Set install dir and local_install flag
#
local_install="no"
install_dir="/usr/local"

if test -n "$location" ; then
  case $location in

    here)
      local_install="yes"
      install_dir="$local_dir"
      ;;

    /*)
      install_dir="$location"
      if test "$location" -ef "$local_dir" ; then
         local_install="yes"
      fi
      ;;

    *)
      echo "The directory must be given as an absolute path"
      exit 1;;

  esac
fi


#
# Check that the tools exist and are executable
#
if test "$local_install" = "no" ; then
  { test -f "$install" -a -x "$install" ; } ||
  { echo "$failure" ; echo "Can't find $install" ; echo "" ; exit 1 ; }
fi

{ test -f "$link" -a -x "$link"; } ||
  { echo "$failure" ; echo "Can't find $link" ; echo "" ; exit 1 ; }


#
# Install directories
#
bindir="$install_dir/bin"
libdir="$install_dir/lib"
pkgconfigdir="$libdir/pkgconfig"
includedir="$install_dir/include"
docdir="$install_dir/share/doc/yices-$version"
licensesdir="$install_dir/share/licenses/yices-$version"


#
# Refuse accidental replacement.  A shared prefix such as /usr/local may
# already contain another Yices release.  Directories may pre-exist, but every
# file or link this script would replace requires explicit authorization.
#
if test "$local_install" = "no" -a "$replace_existing" = "no" ; then
  collision_found=no

  check_target () {
    if test -e "$1" -o -L "$1" ; then
      echo "Existing install path: $1" >&2
      collision_found=yes
    fi
  }

  check_group () {
    destination=$1
    shift
    for source_path in "$@" ; do
      check_target "$destination/${source_path##*/}"
    done
  }

  check_group "$bindir" ./bin/*
  check_group "$includedir" ./include/*.h
  check_group "$libdir" ./lib/*.2.dylib
  check_group "$pkgconfigdir" ./lib/pkgconfig/yices.pc
  check_group "$docdir" ./LICENSE ./NOTICES ./PROVENANCE
  check_group "$licensesdir" ./LICENSES/*
  check_target "$libdir/libyices.dylib"

  if test "$collision_found" = "yes" ; then
    echo "$failure"
    echo "Refusing to replace an existing Yices installation."
    echo "Choose a fresh prefix or rerun with --replace-existing."
    echo ""
    exit 1
  fi
fi


#
# For non-local install:
# create the install directories then copy the files
#
if test "$local_install" = "no" ; then
  echo "Installing Yices in $install_dir"
  { $install -d "$install_dir" "$bindir" "$libdir" "$pkgconfigdir" "$includedir" "$docdir" "$licensesdir" \
    && $install -m 0644 ./include/*.h "$includedir" \
    && $install ./bin/* "$bindir" \
    && $install ./lib/*.2.dylib "$libdir" \
    && $install -m 0644 ./lib/pkgconfig/yices.pc "$pkgconfigdir" \
    && $install -m 0644 ./LICENSE "$docdir" \
    && $install -m 0644 ./NOTICES "$docdir" \
    && $install -m 0644 ./PROVENANCE "$docdir" \
    && $install -m 0644 ./LICENSES/* "$licensesdir" ; } 2> /dev/null ||
  { echo "$failure"
    echo "Could not create install directories or copy files"
    echo "Check that you have the right permissions"
    echo "or try sudo $0"
    echo ""
    exit 1 ; }
fi


#
# Preserve the packaged @rpath install name and signature state for every
# destination. The copied dylib must remain byte-for-byte identical to the
# validated release artifact; consumers select its location with rpath.
#
# Create the symbolic link to lib/liyices.2.dylib
# on Mac OS, the symbolic link permissions matter.
# To make things usable, we force umask to 22:
# this gives xwrx_rx_r to the symbolic link.
#
umask 22
{ "$link" -sf "$dylib_file" "$libdir/libyices.dylib" ; } ||
  { echo "$failure"
    echo "Could not create symbolic link libyices.dylib"
    echo ""
    exit 1 ; }

echo "Done"
