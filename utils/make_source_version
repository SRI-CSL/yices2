#
# Script to build yices_version.c from yices_version_template.txt
#
# Usage:
#  ./make_source_version <template> <result> <version> <mode> <arch>
# where
#   <template> = source template    (normally src/api/yices_version_termplate.txt)
#   <result>   = version file       (normally src/api/yices_version.c)
#   <version>  = version number     (e.g., 2.2.2)
#   <mode>     = compilation mode   (release or debug)
#   <arch>     = build architecture (e.g., x86_64-unknown-linux-gnu)
#
#

usage="Usage: $0 <template> <result> <version> <mode> <arch>"

if test $# -ne 5 ; then
  echo "$usage"
  exit 2
fi

template=$1
result=$2
version=$3
mode=$4
arch=$5


#
# Check that template is readable
#
test -f $template || { echo "Can't open $template" ; exit 1 ; }


#
# Temporary file
#
os_name=`uname 2>/dev/null` || os_name=unknown

case "$os_name" in
  *Darwin* )
     mktemp_cmd="/usr/bin/mktemp -t out"
  ;;

  * )
     mktemp_cmd=mktemp
  ;;
esac

tempfile=`$mktemp_cmd` || { echo "Can't create temporary file" ; exit 1 ; }


#
# Date and git commit
#
now=`date +"%Y-%m-%d"`

#
# Revision.
#
# YICES_SOURCE_REVISION, if set, wins. The release build sets it so that a
# build from a source tarball reports the real release commit. Without it a
# tarball build has no .git directory, git rev-parse fails, and the binary
# truthfully reports "unknown" rather than claiming that a potentially
# modified downstream tree is the pristine release commit. README documents
# how an unmodified source-archive build can use the authenticated receipt.
#
# Fall back to git for ordinary development builds only when the source root
# itself is a Git work tree. Git normally searches parent directories; without
# this boundary an extracted source archive inside an unrelated work tree can
# inherit that outer repository's commit. Only then fall back to "unknown".
#
if test -n "$YICES_SOURCE_REVISION" ; then
  rev="$YICES_SOURCE_REVISION"
else
  script_dir=`CDPATH= cd -- "$(dirname -- "$0")" 2>/dev/null && pwd -P`
  source_root=`CDPATH= cd -- "$script_dir/.." 2>/dev/null && pwd -P`
  git_root=unknown
  if test -n "$source_root" && test -e "$source_root/.git" ; then
    git_root=`git -C "$source_root" rev-parse --show-toplevel 2>/dev/null || echo unknown`
  fi
  if test "$git_root" = "$source_root" ; then
    rev=`git -C "$source_root" rev-parse HEAD 2>/dev/null || echo unknown`
  else
    rev=unknown
  fi
fi


#
# Create the revision-file in temp
#
sed -e "s/YICES_VERSION/$version/g" -e "s/YICES_COMPILATION_DATE/$now/g" \
    -e "s/REVISION/$rev/g" -e "s/YICES_ARCH/$arch/g" -e "s/YICES_BUILD_MODE/$mode/g" \
    $template > $tempfile

#
# Copy tempfile as result if they differ
#
diff -q -N $tempfile $result > /dev/null || cp $tempfile $result

rm -f $tempfile


