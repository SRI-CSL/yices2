#
# Build Makefile
#
# Must be invoked with the following variables set
#
#   YICES_TOP_DIR = top-level directory of Yices
#   YICES_MODE = build mode
#   YICES_MAKE_INCLUDE = configuration file to include
#   YICES_VERSION = full version
#   MAJOR = major version number
#   MINOR = minor version number
#   PATCH_LEVEL = patch level
#   ARCH = architecture (e.g, i686-pc-linux-gnu)
#   POSIXOS = OS (e.g., linux)
#
# Config variables are imported by including the file
#   $(YICES_TOP_DIR)/$(YICES_MAKE_INCLUDE)
#
# This file is constructed by running configure on the
# host and it defines the compilation tools and flags
# and the GMP libraries to use.
#

SHELL=/bin/sh

ifeq (,$(YICES_TOP_DIR))
 $(error "YICES_TOP_DIR is undefined")
endif

ifeq (,$(YICES_MAKE_INCLUDE))
 $(error "YICES_MAKE_INCLUDE is undefined")
endif

include $(YICES_TOP_DIR)/$(YICES_MAKE_INCLUDE)

#
# ldconfig is used by the install rules.
# We don't check for ldconfig in configure.ac (since that doesn't
# make much sense). We use /sbin/ldconfig as default here. If that's
# wrong, change it on the command line:
#
#   make install LDCONFIG=...
#
LDCONFIG=/sbin/ldconfig

#
# Script/command to build a README file from a template
#
arm_android=$(findstring arm-linux-android,$(ARCH))
ifeq ($(arm_android),arm-linux-android)
MKREADME=./utils/mkreadme-android
else
MKREADME=./utils/mkreadme
endif

#
# Template + script to construct yices_version.c
#
template=./src/api/yices_version_template.txt
MKVERSION=./utils/make_source_version
MKARCHIVE=./scripts/create-release-archive.sh

#
# Source directories
#
srcdir = src
srcsubdirs = mt io terms utils solvers solvers/floyd_warshall \
    solvers/funs solvers/bv solvers/egraph solvers/cdcl solvers/simplex solvers/quant \
    parser_utils model api frontend frontend/common \
    frontend/smt1 frontend/yices frontend/smt2 context exists_forall \
    mcsat mcsat/eq mcsat/weq mcsat/uf mcsat/bool mcsat/ite mcsat/na mcsat/ff mcsat/bv \
    mcsat/bv/explain mcsat/utils mcsat/l2o

testdir = tests/unit
regressdir = tests/regress
regressdir_mcsat = tests/regress/mcsat
apitestdir = tests/api

#
# Build directory: for this architecture and mode
#
build_dir = build/$(ARCH)-$(YICES_MODE)

static_test_lib_target = static-lib
ifeq ($(HAVE_CADICAL_DELEGATE):$(HAVE_KISSAT_DELEGATE),yes:yes)
  static_test_lib_target = static-bin
endif

#
# Build subdirectories: we build two versions of Yices.  One is
# compiled and statically linked with GMP. The other one does not
# include GMP so it requires GMP as a dynamic library at runtime.
#
# build/obj: object files (for version without GMP included)
# build/lib: libraries (GMP not included)
# build/bin: binaries (GMP not included)
#
# build/static_obj: object files (for version statically linked with GMP)
# build/static_lib: libraries (GMP included)
# build/static_bin: binaries linked statically with GMP (and other libraries if possible)
#
# build/static_dll_obj: for mingw and cygwin objectfiles to construct the static
# variant of cygyices.dll or libyices.dll
#
dyn_objdir := $(build_dir)/obj
dyn_libdir := $(build_dir)/lib
dyn_bindir := $(build_dir)/bin

static_objdir := $(build_dir)/static_obj
static_libdir := $(build_dir)/static_lib
static_bindir := $(build_dir)/static_bin

static_dll_objdir := $(build_dir)/static_dll_obj

dyn_objsubdirs := $(srcsubdirs:%=$(dyn_objdir)/%)
static_objsubdirs := $(srcsubdirs:%=$(static_objdir)/%)
static_dll_objsubdirs := $(srcsubdirs:%=$(static_dll_objdir)/%)

#
# Binary distributions:
#
# build_dir/dist: binaries + libraries with distribution not linked with GMP
# build_dir/static_dist: includes GMP (statically linked)
#
dist_dir = $(build_dir)/dist
static_dist_dir = $(build_dir)/static_dist

# Release provenance and relink-kit output.
provenance_dir = $(build_dir)/provenance
provenance_file = $(provenance_dir)/PROVENANCE

relink_work_dir = $(build_dir)/relink-kit
relink_kit_name = yices-$(YICES_VERSION)-relink-kit
relink_kit_dir = $(relink_work_dir)/$(relink_kit_name)
relink_kit_tarfile = yices-$(YICES_VERSION)-$(ARCH)-relink-kit.tar.gz
pic_libyices = $(dyn_libdir)/libyices-pic.a
relink_lib_dir = $(build_dir)/relink_lib
dylib_relink_libyices = $(relink_lib_dir)/libyices-dylib.a

# The CUDD archive is deliberately staged outside the common dependency
# directory so -lcudd cannot select a shared object.  Override this variable
# for a non-release dependency layout.
RELINK_CUDD ?= $(STATIC_DEPDIR)/../cudd-static/libcudd.a

# The macOS configure wrapper guarantees that the first -L entry contains
# only the static CUDD archive. Derive the archive from that configured value
# instead of encoding either builder's dependency layout here.
MACOS_RELINK_CUDD ?= \
  $(patsubst -L%,%,$(firstword $(filter -L%,$(LDFLAGS))))/libcudd.a
macos_release_cflags = $(strip $(CFLAGS) -fvisibility=hidden -Wall \
  -Wredundant-decls -O3 -fomit-frame-pointer $(NO_STACK_PROTECTOR))
dependency_buildinfo_keys = \
  dependency-build-receipt-sha256 dependency-build-platform \
  delegate-metadata-profile delegate-metadata-script-sha256 \
  dependency-build-arch dependency-deployment-target dependency-cc \
  dependency-cc-version dependency-cxx dependency-cxx-version \
  dependency-ar-version dependency-ar-command dependency-cmake-version \
  dependency-make-version \
  dependency-ninja-version dependency-cflags dependency-cxxflags \
  cudd-repo cudd-commit cudd-tree cudd-source-file cudd-source-sha256 \
  cudd-configure-args cudd-tests cudd-archive-sha256 cudd-header-sha256 \
  cadical-repo cadical-commit cadical-tree cadical-source-file \
  cadical-source-sha256 cadical-configure-args cadical-tests \
  cadical-archive-sha256 cadical-header-sha256 \
  cryptominisat-repo cryptominisat-commit cryptominisat-tree \
  cryptominisat-source-file cryptominisat-source-sha256 \
  cryptominisat-submodule-policy cryptominisat-cmake-args \
  cryptominisat-export-profile cryptominisat-upstream-archive-sha256 \
  cryptominisat-export-record-sha256 \
  cryptominisat-tests cryptominisat-archive-sha256 \
  cryptominisat-header-sha256 \
  kissat-repo kissat-commit kissat-tree kissat-source-file \
  kissat-source-sha256 kissat-configure-args kissat-tests \
  kissat-raw-archive-sha256 kissat-namespaced-archive-sha256 \
  kissat-header-sha256 kissat-namespace-script-file \
  kissat-namespace-script-sha256


#
# Directories and temporary file to build tarfiles
# - we do this in two steps: the includes, binaries, and library files
#   to be distributed are constructed by invoking make -C src
#   and copied into $(dist_dir)
#   (what's required is defined in src/Makefile and may depend
#    on the OS + compilation mode).
# - the full tar file is built from $(dist_dir) + the generic files
#   that are independent of OS and compilation modes
# - the name of the tar file depends on ARCH + MODE
#
# All tarfiles are stored in ./distributions
#
distributions = ./distributions
bindist_name = yices-$(YICES_VERSION)
bindist_dir = $(build_dir)/$(bindist_name)

ifeq ($(YICES_MODE),debug)
  bindist_tarfile = $(bindist_name)-$(ARCH)-dbg.tar.gz
  static_bindist_tarfile = $(bindist_name)-$(ARCH)-static-gmp-dbg.tar.gz
else
  bindist_tarfile = $(bindist_name)-$(ARCH).tar.gz
  static_bindist_tarfile = $(bindist_name)-$(ARCH)-static-gmp.tar.gz
endif



#
# Build subdirectories if they are missing
#
$(build_dir):
	$(MKDIR_P) $(build_dir)

$(dyn_objdir):
	$(MKDIR_P) $(dyn_objdir)

$(dyn_objsubdirs):
	$(MKDIR_P) $@

$(dyn_libdir):
	$(MKDIR_P) $(dyn_libdir)

$(dyn_bindir):
	$(MKDIR_P) $(dyn_bindir)

$(static_objdir):
	$(MKDIR_P) $(static_objdir)

$(static_objsubdirs):
	$(MKDIR_P) $@

$(static_dll_objdir):
	$(MKDIR_P) $(static_dll_objdir)

$(static_dll_objsubdirs):
	$(MKDIR_P) $@

$(static_libdir):
	$(MKDIR_P) $(static_libdir)

$(static_bindir):
	$(MKDIR_P) $(static_bindir)

$(distdir):
	$(MKDIR_P) $(distdir)

$(static_distdir):
	$(MKDIR_P) $(static_distdir)


build_subdirs: $(build_dir) $(dyn_objsubdirs) $(dyn_libdir) $(dyn_bindir)

static_build_subdirs-mingw static_build_subdirs-cygwin: $(static_dll_objsubdirs)

static_build_subdirs-darwin static_build_subdirs-linux static_build_subdirs-unix static_build_subdirs-freebsd static_build_subdirs-netbsd:

static_build_subdirs: $(build_dir) $(static_objsubdirs) $(static_libdir) $(static_bindir) \
	static_build_subdirs-$(POSIXOS)

.PHONY: build_subdirs static_build_subdirs static_build_subdirs-darwin static-build_subdirs-cygwin \
	static_build_subdirs-mingw static_build_subdirs-linux static_build_subdirs-unix \
	static_build_subdirs-freebsd static_build_subdirs-netbsd

#
# Compilation
#
all: obj static-obj lib static-lib bin static-bin

obj: build_subdirs version
	@ echo "=== Building objects ==="
	@ $(MAKE) -C $(srcdir) BUILD=../$(build_dir) obj

static-obj: static_build_subdirs version
	@ echo "=== Building static objects ==="
	@ $(MAKE) -C $(srcdir) BUILD=../$(build_dir) static-obj

lib: build_subdirs version
	@ echo "=== Building libraries ==="
	@ $(MAKE) -C $(srcdir) BUILD=../$(build_dir) lib

static-lib: static_build_subdirs build_subdirs version
	@ echo "=== Building libraries with GMP ==="
	@ $(MAKE) -C $(srcdir) BUILD=../$(build_dir) static-lib

pic-lib: build_subdirs version
	@ echo "=== Building PIC archive for the relink kit ==="
	@ $(MAKE) -C $(srcdir) BUILD=../$(build_dir) pic-lib

dylib-relink-lib: static_build_subdirs build_subdirs version
	@ echo "=== Building exact macOS dylib archive for the relink kit ==="
	@ $(MAKE) -C $(srcdir) BUILD=../$(build_dir) dylib-relink-lib

bin: build_subdirs version
	@ echo "=== Building binaries ==="
	@ $(MAKE) -C $(srcdir) BUILD=../$(build_dir) bin

static-bin: static_build_subdirs version
	@ echo "=== Building static binaries ==="
	@ $(MAKE) -C $(srcdir) BUILD=../$(build_dir) static-bin

# On macOS, capture hashes from the staged, stripped files that are packaged.
# On Linux, retain the build-tree inputs used by the libxcrypt symbol gate.
ifeq ($(POSIXOS),darwin)
release_provenance_deps = static-dist
release_provenance_bindir = $(static_dist_dir)/bin
release_provenance_libdir = $(static_dist_dir)/lib
release_provenance_cudd = $(MACOS_RELINK_CUDD)
else
release_provenance_deps = static-bin static-lib
release_provenance_bindir = $(static_bindir)
release_provenance_libdir = $(static_libdir)
release_provenance_cudd = $(RELINK_CUDD)
endif

release-provenance: $(release_provenance_deps)
	@ if test "$(POSIXOS)" = linux; then \
	    test -n "$(BUILDER_IMAGE)" || { echo "BUILDER_IMAGE is required for Linux release provenance" >&2; exit 1; }; \
	    test -n "$(BUILDER_IMAGE_DIGEST)" || { echo "BUILDER_IMAGE_DIGEST is required for Linux release provenance" >&2; exit 1; }; \
	    test -n "$(BUILDER_BASE_IMAGE)" || { echo "BUILDER_BASE_IMAGE is required for Linux release provenance" >&2; exit 1; }; \
	  fi
	@ test -n "$(RELEASE_INPUTS_DIR)" || \
	  { echo "RELEASE_INPUTS_DIR is required for release provenance" >&2; exit 1; }
	@ test -n "$(GMP_SOURCE_ARCHIVE)" || \
	  { echo "GMP_SOURCE_ARCHIVE is required for release provenance" >&2; exit 1; }
	@ test -n "$(GMP_SOURCE_RECEIPT)" || \
	  { echo "GMP_SOURCE_RECEIPT is required for release provenance" >&2; exit 1; }
	@ test -n "$(GMP_NORMAL_HEADER)" || \
	  { echo "GMP_NORMAL_HEADER is required for release provenance" >&2; exit 1; }
	@ test -n "$(GMP_PIC_HEADER)" || \
	  { echo "GMP_PIC_HEADER is required for release provenance" >&2; exit 1; }
	@ test -n "$(LIBPOLY_SOURCE_RECEIPT)" || \
	  { echo "LIBPOLY_SOURCE_RECEIPT is required for release provenance" >&2; exit 1; }
	@ test -n "$(LIBPOLY_HEADER_DIR)" || \
	  { echo "LIBPOLY_HEADER_DIR is required for release provenance" >&2; exit 1; }
	@ test -n "$(DEPENDENCY_SOURCE_RECEIPT)" || \
	  { echo "DEPENDENCY_SOURCE_RECEIPT is required for release provenance" >&2; exit 1; }
	BUILDER_IMAGE="$(BUILDER_IMAGE)" \
	BUILDER_IMAGE_DIGEST="$(BUILDER_IMAGE_DIGEST)" \
	BUILDER_BASE_IMAGE="$(BUILDER_BASE_IMAGE)" \
	CC="$(CC)" \
	AR="$(AR)" \
	LD="$(LD)" \
	GLIBC_SOURCE_FILE="$(GLIBC_SOURCE_FILE)" \
	YICES_VERSION="$(YICES_VERSION)" \
	YICES_SOURCE_REVISION="$(YICES_SOURCE_REVISION)" \
	YICES_SOURCE_BRANCH="$$(git rev-parse --abbrev-ref HEAD)" \
	YICES_TARGET_TRIPLE="$(ARCH)" \
	YICES_BUILD_MODE="$(YICES_MODE)" \
	YICES_THREAD_SAFE="$(if $(filter 1,$(THREAD_SAFE)),yes,no)" \
	YICES_BIN_DIR="$(abspath $(release_provenance_bindir))" \
	YICES_LIB_DIR="$(abspath $(release_provenance_libdir))" \
	MANUAL_PDF_FILE="$(abspath doc/manual/manual.pdf)" \
	MANUAL_PDF_SHA256="$(MANUAL_PDF_SHA256)" \
	MANUAL_BUILD_HOST_OS="$(MANUAL_BUILD_HOST_OS)" \
	MANUAL_LATEXMK_VERSION="$(MANUAL_LATEXMK_VERSION)" \
	MANUAL_PDFLATEX_VERSION="$(MANUAL_PDFLATEX_VERSION)" \
	MACOS_SDK_VERSION="$(MACOS_SDK_VERSION)" \
	RELEASE_INPUTS_DIR="$(abspath $(RELEASE_INPUTS_DIR))" \
	GMP_SOURCE_ARCHIVE="$(abspath $(GMP_SOURCE_ARCHIVE))" \
	GMP_SOURCE_RECEIPT="$(abspath $(GMP_SOURCE_RECEIPT))" \
	GMP_STATIC_ARCHIVE="$(abspath $(STATIC_GMP))" \
	GMP_PIC_ARCHIVE="$(abspath $(PIC_GMP))" \
	GMP_NORMAL_HEADER="$(abspath $(GMP_NORMAL_HEADER))" \
	GMP_PIC_HEADER="$(abspath $(GMP_PIC_HEADER))" \
	LIBPOLY_SOURCE_RECEIPT="$(abspath $(LIBPOLY_SOURCE_RECEIPT))" \
	LIBPOLY_STATIC_ARCHIVE="$(abspath $(STATIC_LIBPOLY))" \
	LIBPOLY_PIC_ARCHIVE="$(abspath $(PIC_LIBPOLY))" \
	LIBPOLY_HEADER_DIR="$(abspath $(LIBPOLY_HEADER_DIR))" \
	DEPENDENCY_SOURCE_RECEIPT="$(abspath $(DEPENDENCY_SOURCE_RECEIPT))" \
	DEPENDENCY_INCLUDE_DIR="$(abspath $(STATIC_DELEGATES_INCLUDE_DIR))" \
	CUDD_STATIC_ARCHIVE="$(abspath $(release_provenance_cudd))" \
	CADICAL_STATIC_ARCHIVE="$(abspath $(STATIC_CADICAL_RAW))" \
	CRYPTOMINISAT_STATIC_ARCHIVE="$(abspath $(STATIC_CRYPTOMINISAT_RAW))" \
	KISSAT_RAW_ARCHIVE="$(abspath $(STATIC_KISSAT_RAW))" \
	KISSAT_NAMESPACED_ARCHIVE="$(abspath $(STATIC_KISSAT_YICES))" \
	KISSAT_NAMESPACE_SCRIPT="$(abspath scripts/rewrite-kissat-kitten-symbols.sh)" \
	DELEGATE_METADATA_SCRIPT="$(abspath scripts/delegate-build-metadata.py)" \
	  scripts/capture-release-provenance.sh $(provenance_dir)
	@ test -s $(provenance_dir)/CAPTURE-COMPLETE || \
	  { echo "release provenance completion marker is missing" >&2; exit 1; }


#
# Remove stale version sources for other modes, then generate the requested
# one. Keeping the requested file lets make_source_version preserve its mtime
# when its contents have not changed.
#
version:
	rm -f $(filter-out src/api/yices_$(YICES_MODE)_version.c,$(wildcard src/api/yices_*_version.c))
	$(MKVERSION) $(template) src/api/yices_$(YICES_MODE)_version.c $(YICES_VERSION) $(YICES_MODE) $(ARCH)

.PHONY: version



#
# Tests: all use libyices.a in lib
# Static tests: use libyices.a in static-lib
# Don't regenerate the version file
#
test: build_subdirs version
	@ echo "=== Building libraries ==="
	@ $(MAKE) -C $(srcdir) BUILD=../$(build_dir) lib
	@ echo "=== Building tests ==="
	@ $(MAKE) -C $(testdir) BUILD=../../$(build_dir) all

static-test: static_build_subdirs build_subdirs version
	@ echo "=== Building libraries with GMP ==="
	@ $(MAKE) -C $(srcdir) BUILD=../$(build_dir) $(static_test_lib_target)
	@ echo "=== Building tests ==="
	@ $(MAKE) -C $(testdir) BUILD=../../$(build_dir) all-static

#
# API tests: link with libyices.a like tests
#
check-api: build_subdirs version
	@ echo "=== Building libraries ==="
	@ $(MAKE) -C $(srcdir) BUILD=../$(build_dir) lib
	@ echo "=== Building tests ==="
	@ $(MAKE) -C $(apitestdir) BUILD=../../$(build_dir) all

static-check-api: static_build_subdirs build_subdirs version
	@ echo "=== Building libraries with GMP ==="
	@ $(MAKE) -C $(srcdir) BUILD=../$(build_dir) $(static_test_lib_target)
	@ echo "=== Building tests ==="
	@ $(MAKE) -C $(apitestdir) BUILD=../../$(build_dir) all-static


#
# Regressions
#
check: regress
mcsat-check: mcsat-regress
static-check: static-regress
delegate-check: delegate-regress
static-delegate-check: static-delegate-regress

regress: build_subdirs version
	@ echo "=== Building binaries ==="
	@ $(MAKE) -C $(srcdir) BUILD=../$(build_dir) bin
	@ echo "=== Running regressions ==="
	+@ $(regressdir)/check.sh $(regressdir) $(build_dir)/bin

delegate-regress: build_subdirs version
	@ echo "=== Building binaries ==="
	@ $(MAKE) -C $(srcdir) BUILD=../$(build_dir) bin
	@ echo "=== Running delegate-only regressions ==="
	+@ REGRESS_DELEGATE_MODE=only $(regressdir)/check.sh $(regressdir) $(build_dir)/bin


mcsat-regress: build_subdirs version
	@ echo "=== Building binaries ==="
	@ $(MAKE) -C $(srcdir) BUILD=../$(build_dir) bin
	@ echo "=== Running regressions ==="
	+@ $(regressdir)/check.sh $(regressdir_mcsat) $(build_dir)/bin


static-regress: static_build_subdirs version
	@ echo "=== Building binaries ==="
	@ $(MAKE) -C $(srcdir) BUILD=../$(build_dir) static-bin
	@ echo "=== Running regressions ==="
	+@ $(regressdir)/check.sh $(regressdir) $(build_dir)/static_bin

static-delegate-regress: static_build_subdirs version
	@ echo "=== Building binaries ==="
	@ $(MAKE) -C $(srcdir) BUILD=../$(build_dir) static-bin
	@ echo "=== Running delegate-only regressions ==="
	+@ REGRESS_DELEGATE_MODE=only $(regressdir)/check.sh $(regressdir) $(build_dir)/static_bin


static-mcsat-regress: static_build_subdirs version
	@ echo "=== Building binaries ==="
	@ $(MAKE) -C $(srcdir) BUILD=../$(build_dir) static-bin
	@ echo "=== Running regressions ==="
	+@ $(regressdir)/check.sh $(regressdir_mcsat) $(build_dir)/static_bin


.PHONY: all obj static-obj lib static-lib pic-lib dylib-relink-lib bin static-bin release-provenance test static-test \
    regress delegate-regress static-regress static-delegate-regress \
    check delegate-check static-check static-delegate-check \
    check-api static-check-api


#
# Documentation: for now we just build manual.pdf
# this assumes latexmk is available
#
doc:
	@ echo "=== Building the documentation ==="
	@ (cd doc/manual ; \
          (latexmk -pdf manual || \
            (echo "===================================="; \
             echo "  WARNING: can't run latexmk"; \
             echo "   manual.pdf may be out-of-date"; \
             echo "===================================="; )))


documentation manual: doc

.PHONY: doc documentation manual


#
# Binary distribution:
#
# On mingw, there's a manual step involved. So build the
# distribution as follows:
# 1) make dist (or make static-dist)
# 2) from a Visual Studio console,
#    go to ./build/i686-pc-mingw32-release/dist/lib
#    then type 'lib /machine:x86 /def:libyices.def
# 3) clean up: remove libyices.def and libyices.exp
#    from ./build/i686-pc-mingw32-release/dist/lib
# 4) make tarfile (or make static-tarfile)
#
# On other platforms: make binary-distribution or make
# static-distribution should work.
#
# On MacOS X, the tar command adds files of the form ._xxxx to store
# metadata/extended file attributes. This gets ugly if we untar on
# some other platform. To prevent generation of these ._xxxx files, it
# is enough to set the environment variable COPYFILE_DISABLE to 1. We
# do this systematically (even on other systems). Hopefully,
# COPYFILE_DISABLE should not matter on other systems than MacOS X.
#
# We use a shell script ./util/mkreadme to make sure
# the README file in the tarfile is up to date (probably
# not foolproof)
#
$(distributions):
	$(MKDIR_P) $(distributions)

$(dist_dir):
	$(MKDIR_P) $(dist_dir)

$(static_dist_dir):
	$(MKDIR_P) $(static_dist_dir)

binary-distribution: dist tarfile

static-distribution: static-dist static-tarfile

dist: build_subdirs version $(dist_dir)
	@ echo "=== Preparing binary distribution ==="
	@ $(MAKE) -C $(srcdir) BUILD=../$(build_dir) dist

static-dist: static_build_subdirs build_subdirs version $(static_dist_dir)
	@ echo "=== Preparing static binary distribution ==="
	@ $(MAKE) -C $(srcdir) BUILD=../$(build_dir) static-dist


tarfile: dist $(distributions) doc release-provenance
	@ echo "=== Building $(bindist_tarfile) ==="
	@ test -s doc/manual/manual.pdf && test doc/manual/manual.pdf -nt doc/manual/manual.tex || \
	  { echo "ERROR: doc/manual/manual.pdf is missing or older than doc/manual/manual.tex" >&2; exit 1; }
	rm -f -r $(bindist_dir)
	$(MKDIR_P) $(bindist_dir)
	cp -r $(dist_dir)/* $(bindist_dir)
	$(MKDIR_P) $(bindist_dir)/lib/pkgconfig
	$(SED) 's|^prefix=.*|prefix=$${pcfiledir}/../..|' yices.pc > $(bindist_dir)/lib/pkgconfig/yices.pc
	cp etc/NOTICES $(bindist_dir)
	cp -R LICENSES $(bindist_dir)
	cp $(provenance_file) $(bindist_dir)/PROVENANCE
	cp LICENSE.txt $(bindist_dir)/LICENSE
	$(MKREADME) $(dist_dir) etc/README.$(POSIXOS) > $(bindist_dir)/README
	if test -f etc/install-yices.$(POSIXOS) ; then \
	  cp etc/install-yices.$(POSIXOS) $(bindist_dir)/install-yices ; \
	  chmod ug+x $(bindist_dir)/install-yices ; \
	fi
	$(MKDIR_P) $(bindist_dir)/etc
	cp etc/pstdint.h $(bindist_dir)/etc
	$(MKDIR_P) $(bindist_dir)/examples
	for file in `ls examples | $(EGREP) '\.ys$$|\.smt$$|\.c$$|\.smt2$$|\.cpp$$' ` ; do \
	  cp examples/$$file $(bindist_dir)/examples ; \
	done || true
	$(MKDIR_P) $(bindist_dir)/doc
	cp doc/YICES-LANGUAGE $(bindist_dir)/doc
	cp doc/manual/manual.pdf $(bindist_dir)/doc
	chmod -R og+rX $(bindist_dir)
	$(MKARCHIVE) $(abspath $(distributions)/$(bindist_tarfile)) $(build_dir) $(bindist_name)
	chmod -R og+rX $(distributions)
	rm -f -r $(bindist_dir)

static-tarfile: static-dist $(distributions) doc release-provenance
	@ echo "=== Building $(static_bindist_tarfile) ==="
	@ test -s doc/manual/manual.pdf && test doc/manual/manual.pdf -nt doc/manual/manual.tex || \
	  { echo "ERROR: doc/manual/manual.pdf is missing or older than doc/manual/manual.tex" >&2; exit 1; }
	rm -f -r $(bindist_dir)
	$(MKDIR_P) $(bindist_dir)
	cp -r $(static_dist_dir)/* $(bindist_dir)
	$(MKDIR_P) $(bindist_dir)/lib/pkgconfig
	$(SED) 's|^prefix=.*|prefix=$${pcfiledir}/../..|' yices.pc > $(bindist_dir)/lib/pkgconfig/yices.pc
	cp etc/NOTICES $(bindist_dir)
	cp -R LICENSES $(bindist_dir)
	cp $(provenance_file) $(bindist_dir)/PROVENANCE
	cp LICENSE.txt $(bindist_dir)/LICENSE
	$(MKREADME) $(static_dist_dir) etc/README.static.$(POSIXOS) > $(bindist_dir)/README
	if test -f etc/install-yices.$(POSIXOS) ; then \
	  cp etc/install-yices.$(POSIXOS) $(bindist_dir)/install-yices ; \
	  chmod ug+x $(bindist_dir)/install-yices ; \
	fi
	$(MKDIR_P) $(bindist_dir)/etc
	cp etc/pstdint.h $(bindist_dir)/etc
	$(MKDIR_P) $(bindist_dir)/examples
	for file in `ls examples | $(EGREP) '\.ys$$|\.smt$$|\.c$$|\.smt2$$|\.cpp$$' ` ; do \
	  cp examples/$$file $(bindist_dir)/examples ; \
	done || true
	$(MKDIR_P) $(bindist_dir)/doc
	cp doc/YICES-LANGUAGE $(bindist_dir)/doc
	cp doc/manual/manual.pdf $(bindist_dir)/doc
	chmod -R og+rX $(bindist_dir)
	$(MKARCHIVE) $(abspath $(distributions)/$(static_bindist_tarfile)) $(build_dir) $(bindist_name)
	chmod -R og+rX $(distributions)
	rm -f -r $(bindist_dir)


.PHONY: binary-distribution static-distribution dist static-dist \
	tarfile static-tarfile


#
# Linux relink kit
#
# The kit is one release asset with separate executable and shared-library
# payload directories.  The executable payload uses the optimized non-PIC GMP
# and normal LibPoly archives; the shared-library payload uses the PIC builds.
#
relink-kit: static-tarfile pic-lib
	@ test "$(POSIXOS)" = linux || \
	  { echo "The relink-kit target currently supports the Linux release build only" >&2; exit 1; }
	@ set -eu; for file in \
	  "$(STATIC_GMP)" "$(PIC_GMP)" "$(STATIC_LIBPOLY)" "$(PIC_LIBPOLY)" \
	  "$(RELINK_CUDD)" "$(STATIC_CADICAL_RAW)" "$(STATIC_CRYPTOMINISAT_RAW)" \
	  "$(STATIC_KISSAT_YICES)" "$(pic_libyices)" "$(provenance_file)"; do \
	    test -f "$$file" || { echo "Missing relink-kit input: $$file" >&2; exit 1; }; \
	  done
	rm -f -r $(relink_work_dir)
	$(MKDIR_P) $(relink_kit_dir)/executables $(relink_kit_dir)/library \
	  $(relink_kit_dir)/deps $(relink_kit_dir)/licenses
	cp etc/relink/README $(relink_kit_dir)/README
	cp etc/NOTICES $(relink_kit_dir)/NOTICES
	cp LICENSE.txt $(relink_kit_dir)/LICENSE
	cp etc/relink/relink-executables.sh etc/relink/relink-library.sh \
	  etc/relink/verify-manifest.sh $(relink_kit_dir)
	cp etc/relink/REBUILDING.md etc/relink/rebuild-gmp-libpoly.sh \
	  etc/relink/prepare-glibc-source.py etc/relink/relink-with-glibc.sh $(relink_kit_dir)
	chmod ug+x $(relink_kit_dir)/rebuild-gmp-libpoly.sh \
	  $(relink_kit_dir)/prepare-glibc-source.py $(relink_kit_dir)/relink-with-glibc.sh
	chmod ug+x $(relink_kit_dir)/relink-executables.sh \
	  $(relink_kit_dir)/relink-library.sh $(relink_kit_dir)/verify-manifest.sh
	cp $(static_objdir)/frontend/yices.o $(relink_kit_dir)/executables/yices.o
	cp $(static_objdir)/frontend/yices_sat.o $(relink_kit_dir)/executables/yices_sat.o
	cp $(static_objdir)/frontend/yices_smtcomp.o $(relink_kit_dir)/executables/yices_smtcomp.o
	cp $(static_objdir)/frontend/yices_smt2.o $(relink_kit_dir)/executables/yices_smt2.o
	cp $(static_libdir)/libyices.a $(relink_kit_dir)/executables/libyices.a
	cp $(pic_libyices) $(relink_kit_dir)/library/libyices-pic.a
	cp $(STATIC_GMP) $(relink_kit_dir)/deps/libgmp-static.a
	cp $(PIC_GMP) $(relink_kit_dir)/deps/libgmp-pic.a
	cp $(STATIC_LIBPOLY) $(relink_kit_dir)/deps/libpoly.a
	cp $(PIC_LIBPOLY) $(relink_kit_dir)/deps/libpicpoly.a
	cp $(RELINK_CUDD) $(relink_kit_dir)/deps/libcudd.a
	cp $(STATIC_CADICAL_RAW) $(relink_kit_dir)/deps/libcadical.a
	cp $(STATIC_CRYPTOMINISAT_RAW) $(relink_kit_dir)/deps/libcryptominisat5.a
	cp $(STATIC_KISSAT_YICES) $(relink_kit_dir)/deps/libkissat_yices.a
	cp LICENSES/LGPL-2.1-or-later.txt $(relink_kit_dir)/licenses/LGPL-2.1-or-later.txt
	cp LICENSES/LGPL-3.0-or-later.txt $(relink_kit_dir)/licenses/LGPL-3.0-or-later.txt
	cp LICENSES/GPL-2.0-only.txt $(relink_kit_dir)/licenses/GPL-2.0-only.txt
	cp LICENSES/GPL-3.0-or-later.txt $(relink_kit_dir)/licenses/GPL-3.0-or-later.txt
	cp LICENSES/MIT.txt $(relink_kit_dir)/licenses/MIT.txt
	cp LICENSES/Apache-2.0.txt $(relink_kit_dir)/licenses/Apache-2.0.txt
	cp LICENSES/BSD-3-Clause.txt $(relink_kit_dir)/licenses/BSD-3-Clause.txt
	cp LICENSES/CPython-3.4.0a3-LICENSE.txt \
	  $(relink_kit_dir)/licenses/CPython-3.4.0a3-LICENSE.txt
	cp etc/relink/BUILDINFO.template $(relink_kit_dir)/BUILDINFO
	@ set -eu; \
	  sha_file() { \
	    if command -v sha256sum >/dev/null 2>&1; then line=$$(sha256sum "$$1") || return; \
	    else line=$$(shasum -a 256 "$$1") || return; fi; \
	    value=$${line%% *}; \
	    case "$$value" in ''|*[!0-9a-f]*) return 1 ;; esac; \
	    test "$${#value}" -eq 64 || return 1; \
	    printf '%s\n' "$$value"; \
	  }; \
	  get_prov() { $(SED) -n "s/^$$1: //p" $(provenance_file) | head -1; }; \
	  replace() { \
	    key=$$1; value=$$2; \
	    test -n "$$value" || { echo "empty BUILDINFO value for $$key" >&2; exit 1; }; \
	    count=$$(grep -c "^$$key:" $(relink_kit_dir)/BUILDINFO || true); \
	    test "$$count" -eq 1 || { echo "BUILDINFO key $$key occurs $$count times" >&2; exit 1; }; \
	    $(SED) -i "s|^$$key:.*|$$key: $$value|" $(relink_kit_dir)/BUILDINFO; \
	  }; \
	  normalize_production_inputs() { \
	    normalized=; \
	    for input in $$1; do \
	      case "$$input" in \
	        -lcudd|"$(RELINK_CUDD)") mapped=deps/libcudd.a ;; \
	        -lcryptominisat5|"$(STATIC_CRYPTOMINISAT_RAW)") mapped=deps/libcryptominisat5.a ;; \
	        -lcadical|"$(STATIC_CADICAL_RAW)") mapped=deps/libcadical.a ;; \
	        -lkissat_yices|"$(STATIC_KISSAT_YICES)") mapped=deps/libkissat_yices.a ;; \
	        "$(STATIC_LIBPOLY)") mapped=deps/libpoly.a ;; \
	        "$(PIC_LIBPOLY)") mapped=deps/libpicpoly.a ;; \
	        "$(STATIC_GMP)") mapped=deps/libgmp-static.a ;; \
	        "$(PIC_GMP)") mapped=deps/libgmp-pic.a ;; \
	        -lm|-lstdc++|-lpthread) mapped=$$input ;; \
	        *) echo "unmapped production link input: $$input" >&2; return 1 ;; \
	      esac; \
	      if test -n "$$normalized"; then normalized="$$normalized $$mapped"; else normalized=$$mapped; fi; \
	    done; \
	    printf '%s\n' "$$normalized"; \
	  }; \
	  revision=$${YICES_SOURCE_REVISION:-$$(git rev-parse HEAD 2>/dev/null || echo unknown)}; \
	  branch=$$(git rev-parse --abbrev-ref HEAD 2>/dev/null || echo unknown); \
	  artifact=$(static_bindist_tarfile); \
	  artifact_sha=$$(sha_file $(distributions)/$(static_bindist_tarfile)); \
	  builder="$(BUILDER_IMAGE)"; \
	  builder_digest="$(BUILDER_IMAGE_DIGEST)"; \
	  builder_base="$(BUILDER_BASE_IMAGE)"; \
	  os=$$(if test -r /etc/os-release; then . /etc/os-release; echo "$${PRETTY_NAME:-unknown}"; else uname -sr; fi); \
	  elf=$$(readelf -hW $(static_bindir)/yices | awk -F: '/Class:/{gsub(/^[ \t]+/,"",$$2); c=$$2} /OS\/ABI:/{gsub(/^[ \t]+/,"",$$2); a=$$2} /Machine:/{gsub(/^[ \t]+/,"",$$2); m=$$2} END{print c ", " m ", " a}'); \
	  thread_safe=no; test "$(THREAD_SAFE)" = 1 && thread_safe=yes || true; \
	  cxx_archive=$$($(CC) -print-file-name=libstdc++.a); \
	  cxx_runtime=$$(rpm -qf --qf '%{NEVRA}' "$$cxx_archive" 2>/dev/null || echo "$$cxx_archive"); \
	  glibc_source=$$(get_prov glibc-source-rpm); \
	  glibc_binary_package=$$(get_prov glibc-binary-package); \
	  glibc_binary_nevr=$$(get_prov glibc-binary-nevr); \
	  glibc_archive_sha=$$(get_prov glibc-archive-sha256); \
	  test -n "$$glibc_binary_package" || { echo "missing glibc-binary-package in PROVENANCE" >&2; exit 1; }; \
	  test -n "$$glibc_binary_nevr" || { echo "missing glibc-binary-nevr in PROVENANCE" >&2; exit 1; }; \
	  test -n "$$glibc_archive_sha" || { echo "missing glibc-archive-sha256 in PROVENANCE" >&2; exit 1; }; \
	  glibc_file=$$(find $(provenance_dir)/glibc -type f -name '*.src.rpm' -print | head -1); \
	  glibc_sha=$$(sha_file "$$glibc_file"); \
	  gmp_asset=$$(get_prov gmp-source-file); \
	  libpoly_asset=$$(get_prov libpoly-source-file); \
	  raw_nogmp=$$($(MAKE) -s --no-print-directory -C $(srcdir) BUILD=../$(build_dir) print-release-static-nogmp-libs); \
	  raw_static=$$($(MAKE) -s --no-print-directory -C $(srcdir) BUILD=../$(build_dir) print-release-static-libs); \
	  raw_pic=$$($(MAKE) -s --no-print-directory -C $(srcdir) BUILD=../$(build_dir) print-release-pic-libs); \
	  test -n "$$raw_nogmp" || \
	    { echo "production STATIC_NOGMP_LIBS is empty" >&2; exit 1; }; \
	  test -n "$$raw_static" || \
	    { echo "production STATIC_LIBS is empty" >&2; exit 1; }; \
	  test -n "$$raw_pic" || \
	    { echo "production PIC_LIBS is empty" >&2; exit 1; }; \
	  production_nogmp=$$(normalize_production_inputs "$$raw_nogmp"); \
	  production_static=$$(normalize_production_inputs "$$raw_static"); \
	  production_pic=$$(normalize_production_inputs "$$raw_pic"); \
	  expected_nogmp='deps/libcudd.a -lm deps/libcryptominisat5.a deps/libcadical.a deps/libkissat_yices.a -lstdc++ -lm -lpthread'; \
	  expected_static="$$expected_nogmp deps/libpoly.a deps/libgmp-static.a"; \
	  expected_pic="$$expected_nogmp deps/libpicpoly.a deps/libgmp-pic.a"; \
	  test "$$production_nogmp" = "$$expected_nogmp" || { \
	    echo "unexpected normalized STATIC_NOGMP_LIBS: $$production_nogmp" >&2; \
	    exit 1; \
	  }; \
	  test "$$production_static" = "$$expected_static" || { \
	    echo "unexpected normalized STATIC_LIBS: $$production_static" >&2; \
	    exit 1; \
	  }; \
	  test "$$production_pic" = "$$expected_pic" || { \
	    echo "unexpected normalized PIC_LIBS: $$production_pic" >&2; \
	    exit 1; \
	  }; \
	  replace yices-commit "$$revision"; \
	  replace yices-branch "$$branch"; \
	  replace artifact "$$artifact"; \
	  replace artifact-sha256 "$$artifact_sha"; \
	  replace kit-built "$$(date -u +%Y-%m-%dT%H:%M:%SZ)"; \
	  replace target-triple "$(ARCH)"; \
	  replace elf-class "$$elf"; \
	  replace build-host-os "$$os"; \
	  replace thread-safe "$$thread_safe"; \
	  replace builder-image "$$builder"; \
	  replace builder-image-digest "$$builder_digest"; \
	  replace builder-base-image "$$builder_base"; \
	  replace cc "$(CC)"; \
	  replace cc-version "$$($(CC) --version | head -1)"; \
	  replace cxx-runtime "$$cxx_runtime"; \
	  replace ld-version "$$($(LD) --version | head -1)"; \
	  replace ar-version "$$($(AR) --version | head -1)"; \
	  replace libc-runtime "$$(ldd --version | head -1)"; \
	  replace manual-pdf-sha256 "$$(get_prov manual-pdf-sha256)"; \
	  replace manual-build-host-os "$$(get_prov manual-build-host-os)"; \
	  replace manual-latexmk-version "$$(get_prov manual-latexmk-version)"; \
	  replace manual-pdflatex-version "$$(get_prov manual-pdflatex-version)"; \
	  replace sdk-version "$$(get_prov sdk-version)"; \
	  replace cflags "$(strip $(CFLAGS) -fvisibility=hidden -Wall -Wredundant-decls $(if $(filter 1,$(THREAD_SAFE)),-pthread) -O3 -fomit-frame-pointer $(NO_STACK_PROTECTOR))"; \
	  replace static-flag "-static"; \
	  replace bin-ldflags "$(if $(filter 1,$(THREAD_SAFE)),-pthread,EMPTY)"; \
	  replace link-yices "$(CC) $(strip $(CFLAGS) -fvisibility=hidden -Wall -Wredundant-decls $(if $(filter 1,$(THREAD_SAFE)),-pthread) -O3 -fomit-frame-pointer $(NO_STACK_PROTECTOR)) $(if $(filter 1,$(THREAD_SAFE)),-pthread) -static -o yices executables/yices.o executables/libyices.a $$production_static"; \
	  replace link-yices-smt "$(CC) $(strip $(CFLAGS) -fvisibility=hidden -Wall -Wredundant-decls $(if $(filter 1,$(THREAD_SAFE)),-pthread) -O3 -fomit-frame-pointer $(NO_STACK_PROTECTOR)) $(if $(filter 1,$(THREAD_SAFE)),-pthread) -static -o yices-smt executables/yices_smtcomp.o executables/libyices.a $$production_static"; \
	  replace link-yices-smt2 "$(CC) $(strip $(CFLAGS) -fvisibility=hidden -Wall -Wredundant-decls $(if $(filter 1,$(THREAD_SAFE)),-pthread) -O3 -fomit-frame-pointer $(NO_STACK_PROTECTOR)) $(if $(filter 1,$(THREAD_SAFE)),-pthread) -static -o yices-smt2 executables/yices_smt2.o executables/libyices.a $$production_static"; \
	  replace link-yices-sat "$(CC) $(strip $(CFLAGS) -fvisibility=hidden -Wall -Wredundant-decls $(if $(filter 1,$(THREAD_SAFE)),-pthread) -O3 -fomit-frame-pointer $(NO_STACK_PROTECTOR)) $(if $(filter 1,$(THREAD_SAFE)),-pthread) -static -o yices-sat executables/yices_sat.o executables/libyices.a $$production_nogmp"; \
	  replace link-libyices-so "$(CC) $(strip $(CFLAGS) -fvisibility=hidden -Wall -Wredundant-decls $(if $(filter 1,$(THREAD_SAFE)),-pthread) -O3 -fomit-frame-pointer $(NO_STACK_PROTECTOR)) -shared -o libyices.so.$(YICES_VERSION) -Wl,-soname,libyices.so.$(MAJOR).$(MINOR) -Wl,--no-undefined -Wl,--whole-archive library/libyices-pic.a -Wl,--no-whole-archive $$production_pic -lc"; \
	  replace glibc-binary-package "$$glibc_binary_package $$glibc_binary_nevr"; \
	  replace glibc-source-package "$$glibc_source"; \
	  replace glibc-source-asset "$$(basename "$$glibc_file")"; \
	  replace glibc-source-sha256 "$$glibc_sha"; \
	  replace glibc-archive-sha256 "$$glibc_archive_sha"; \
	  replace gmp-source-asset "$$gmp_asset"; \
	  replace gmp-source-sha256 "$$(get_prov gmp-source-sha256)"; \
	  replace gmp-build-platform "$$(get_prov gmp-build-platform)"; \
	  replace gmp-build-arch "$$(get_prov gmp-build-arch)"; \
	  replace gmp-deployment-target "$$(get_prov gmp-deployment-target)"; \
	  replace gmp-cc "$$(get_prov gmp-cc)"; \
	  replace gmp-cc-version "$$(get_prov gmp-cc-version)"; \
	  replace gmp-cxx "$$(get_prov gmp-cxx)"; \
	  replace gmp-cxx-version "$$(get_prov gmp-cxx-version)"; \
	  replace gmp-layout "$$(get_prov gmp-layout)"; \
	  replace gmp-normal-configure-args "$$(get_prov gmp-normal-configure-args)"; \
	  replace gmp-normal-cflags "$$(get_prov gmp-normal-cflags)"; \
	  replace gmp-normal-cxxflags "$$(get_prov gmp-normal-cxxflags)"; \
	  replace gmp-normal-tests "$$(get_prov gmp-normal-tests)"; \
	  replace gmp-pic-configure-args "$$(get_prov gmp-pic-configure-args)"; \
	  replace gmp-pic-cflags "$$(get_prov gmp-pic-cflags)"; \
	  replace gmp-pic-cxxflags "$$(get_prov gmp-pic-cxxflags)"; \
	  replace gmp-pic-tests "$$(get_prov gmp-pic-tests)"; \
	  replace gmp-static-archive-sha256 "$$(get_prov gmp-static-archive-sha256)"; \
	  replace gmp-pic-archive-sha256 "$$(get_prov gmp-pic-archive-sha256)"; \
	  replace gmp-normal-header-file "$$(get_prov gmp-normal-header-file)"; \
	  replace gmp-normal-header-sha256 "$$(get_prov gmp-normal-header-sha256)"; \
	  replace gmp-pic-header-file "$$(get_prov gmp-pic-header-file)"; \
	  replace gmp-pic-header-sha256 "$$(get_prov gmp-pic-header-sha256)"; \
	  replace libpoly-repo "$$(get_prov libpoly-repo)"; \
	  replace libpoly-commit "$$(get_prov libpoly-commit)"; \
	  replace libpoly-tree "$$(get_prov libpoly-tree)"; \
	  replace libpoly-source-asset "$$libpoly_asset"; \
	  replace libpoly-source-sha256 "$$(get_prov libpoly-source-sha256)"; \
	  replace libpoly-static-archive-sha256 "$$(get_prov libpoly-static-archive-sha256)"; \
	  replace libpoly-pic-archive-sha256 "$$(get_prov libpoly-pic-archive-sha256)"; \
	  replace libpoly-tests "$$(get_prov libpoly-tests)"; \
	  replace libpoly-header-root "$$(get_prov libpoly-header-root)"; \
	  replace libpoly-header-count "$$(get_prov libpoly-header-count)"; \
	  replace libpoly-header-manifest-sha256 "$$(get_prov libpoly-header-manifest-sha256)"; \
	  replace release-inputs-file "$$(get_prov release-inputs-file)"; \
	  replace release-inputs-sha256 "$$(get_prov release-inputs-sha256)"; \
	  for key in $(dependency_buildinfo_keys); do \
	    replace "$$key" "$$(get_prov "$$key")"; \
	  done; \
	  if grep -n 'GENERATED' $(relink_kit_dir)/BUILDINFO; then \
	    echo "BUILDINFO still contains an unfilled placeholder" >&2; exit 1; \
	  fi; \
	  if grep -n -E '^[A-Za-z0-9._-]+:[[:space:]]*$$' $(relink_kit_dir)/BUILDINFO; then \
	    echo "BUILDINFO contains an empty value" >&2; exit 1; \
	  fi
	( cd $(relink_kit_dir) && \
	  find . -type f ! -name MANIFEST.sha256 -print0 | LC_ALL=C sort -z | \
	  xargs -0 sha256sum > MANIFEST.sha256 && \
	  sha256sum --check --strict MANIFEST.sha256 )
	chmod -R og+rX $(relink_kit_dir)
	$(MKARCHIVE) $(distributions)/$(relink_kit_tarfile) \
	  $(relink_work_dir) $(relink_kit_name)
	chmod og+r $(distributions)/$(relink_kit_tarfile)
	@ echo "=== Built $(distributions)/$(relink_kit_tarfile) ==="

.PHONY: relink-kit


#
# macOS relink kit
#
# The configured paths determine whether the kit contains one GMP archive or
# separate executable and dynamic-library archives. The Intel release uses
# one archive for both; Apple Silicon uses two.
#
macos-relink-kit: static-tarfile dylib-relink-lib
	@ test "$(POSIXOS)" = darwin || \
	  { echo "The macos-relink-kit target requires a macOS release configuration" >&2; exit 1; }
	@ set -eu; for file in \
	  "$(static_objdir)/frontend/yices.o" \
	  "$(static_objdir)/frontend/yices_sat.o" \
	  "$(static_objdir)/frontend/yices_smtcomp.o" \
	  "$(static_objdir)/frontend/yices_smt2.o" \
	  "$(static_libdir)/libyices.a" "$(dylib_relink_libyices)" \
	  "$(STATIC_GMP)" "$(PIC_GMP)" \
	  "$(STATIC_LIBPOLY)" "$(PIC_LIBPOLY)" "$(MACOS_RELINK_CUDD)" \
	  "$(STATIC_CADICAL_RAW)" "$(STATIC_CRYPTOMINISAT_RAW)" \
	  "$(STATIC_KISSAT_YICES)" "$(provenance_file)"; do \
	    test -f "$$file" || { echo "Missing macOS relink-kit input: $$file" >&2; exit 1; }; \
	  done
	rm -f -r $(relink_work_dir)
	$(MKDIR_P) $(relink_kit_dir)/executables $(relink_kit_dir)/deps \
	  $(relink_kit_dir)/licenses
	cp etc/relink/README.macos $(relink_kit_dir)/README
	cp etc/NOTICES $(relink_kit_dir)/NOTICES
	cp LICENSE.txt $(relink_kit_dir)/LICENSE
	cp etc/relink/relink-executables-macos.sh \
	  $(relink_kit_dir)/relink-executables.sh
	cp etc/relink/relink-library-macos.sh \
	  $(relink_kit_dir)/relink-library.sh
	cp etc/relink/verify-manifest.sh $(relink_kit_dir)
	cp etc/relink/REBUILDING.md etc/relink/rebuild-gmp-libpoly.sh $(relink_kit_dir)
	chmod ug+x $(relink_kit_dir)/rebuild-gmp-libpoly.sh
	chmod ug+x $(relink_kit_dir)/relink-executables.sh \
	  $(relink_kit_dir)/relink-library.sh $(relink_kit_dir)/verify-manifest.sh
	cp $(static_objdir)/frontend/yices.o $(relink_kit_dir)/executables/yices.o
	cp $(static_objdir)/frontend/yices_sat.o $(relink_kit_dir)/executables/yices_sat.o
	cp $(static_objdir)/frontend/yices_smtcomp.o $(relink_kit_dir)/executables/yices_smtcomp.o
	cp $(static_objdir)/frontend/yices_smt2.o $(relink_kit_dir)/executables/yices_smt2.o
	cp $(static_libdir)/libyices.a $(relink_kit_dir)/deps/libyices.a
	cp $(dylib_relink_libyices) $(relink_kit_dir)/deps/libyices-dylib.a
	cp $(MACOS_RELINK_CUDD) $(relink_kit_dir)/deps/libcudd.a
	cp $(STATIC_CRYPTOMINISAT_RAW) $(relink_kit_dir)/deps/libcryptominisat5.a
	cp $(STATIC_CADICAL_RAW) $(relink_kit_dir)/deps/libcadical.a
	cp $(STATIC_KISSAT_YICES) $(relink_kit_dir)/deps/libkissat_yices.a
	cp $(STATIC_LIBPOLY) $(relink_kit_dir)/deps/libpoly.a
	cp $(PIC_LIBPOLY) $(relink_kit_dir)/deps/libpicpoly.a
	cp $(STATIC_GMP) $(relink_kit_dir)/deps/libgmp-static.a
	@ if test "$(PIC_GMP)" != "$(STATIC_GMP)"; then \
	    cp "$(PIC_GMP)" $(relink_kit_dir)/deps/libgmp-pic.a; \
	  fi
	cp LICENSES/LGPL-3.0-or-later.txt $(relink_kit_dir)/licenses/LGPL-3.0-or-later.txt
	cp LICENSES/GPL-2.0-only.txt $(relink_kit_dir)/licenses/GPL-2.0-only.txt
	cp LICENSES/GPL-3.0-or-later.txt $(relink_kit_dir)/licenses/GPL-3.0-or-later.txt
	cp LICENSES/MIT.txt $(relink_kit_dir)/licenses/MIT.txt
	cp LICENSES/Apache-2.0.txt $(relink_kit_dir)/licenses/Apache-2.0.txt
	cp LICENSES/BSD-3-Clause.txt $(relink_kit_dir)/licenses/BSD-3-Clause.txt
	cp LICENSES/CPython-3.4.0a3-LICENSE.txt \
	  $(relink_kit_dir)/licenses/CPython-3.4.0a3-LICENSE.txt
	@ set -eu; \
	  sha_file() { \
	    if command -v sha256sum >/dev/null 2>&1; then line=$$(sha256sum "$$1") || return; \
	    else line=$$(shasum -a 256 "$$1") || return; fi; \
	    value=$${line%% *}; \
	    case "$$value" in ''|*[!0-9a-f]*) return 1 ;; esac; \
	    test "$${#value}" -eq 64 || return 1; \
	    printf '%s\n' "$$value"; \
	  }; \
	  get_prov() { $(SED) -n "s/^$$1: //p" $(provenance_file) | head -1; }; \
	  normalize_production_inputs() { \
	    normalized=; \
	    for input in $$1; do \
	      case "$$input" in \
	        -lcudd|"$(MACOS_RELINK_CUDD)") mapped=deps/libcudd.a ;; \
	        -lcryptominisat5|"$(STATIC_CRYPTOMINISAT_RAW)") mapped=deps/libcryptominisat5.a ;; \
	        -lcadical|"$(STATIC_CADICAL_RAW)") mapped=deps/libcadical.a ;; \
	        -lkissat|-lkissat_yices|"$(STATIC_KISSAT_RAW)"|"$(STATIC_KISSAT_YICES)") mapped=deps/libkissat_yices.a ;; \
	        "$(STATIC_LIBPOLY)") mapped=deps/libpoly.a ;; \
	        "$(PIC_LIBPOLY)") mapped=deps/libpicpoly.a ;; \
	        "$(STATIC_GMP)") mapped=deps/libgmp-static.a ;; \
	        "$(PIC_GMP)") mapped=$$dylib_gmp ;; \
	        -lm|-lc++|-lpthread) mapped=$$input ;; \
	        *) echo "unmapped macOS production link input: $$input" >&2; return 1 ;; \
	      esac; \
	      if test -n "$$normalized"; then normalized="$$normalized $$mapped"; else normalized=$$mapped; fi; \
	    done; \
	    printf '%s\n' "$$normalized"; \
	  }; \
	  revision=$${YICES_SOURCE_REVISION:-$$(git rev-parse HEAD 2>/dev/null || echo unknown)}; \
	  branch=$$(git rev-parse --abbrev-ref HEAD 2>/dev/null || echo unknown); \
	  artifact=$(static_bindist_tarfile); \
	  artifact_sha=$$(sha_file $(distributions)/$(static_bindist_tarfile)); \
	  archive_count=$$(find $(relink_kit_dir)/deps -type f -name '*.a' -print | wc -l | tr -d ' '); \
	  if test -f $(relink_kit_dir)/deps/libgmp-pic.a; then \
	    gmp_layout='separate normal and PIC archives'; \
	    dylib_gmp=deps/libgmp-pic.a; \
	  else \
	    gmp_layout='one fat PIC archive for both payloads'; \
	    dylib_gmp=deps/libgmp-static.a; \
	  fi; \
	  test "$$gmp_layout" = "$$(get_prov gmp-layout)" || \
	    { echo "GMP layout disagrees with provenance" >&2; exit 1; }; \
	  raw_nogmp=$$($(MAKE) -s --no-print-directory -C $(srcdir) BUILD=../$(build_dir) print-release-static-nogmp-libs); \
	  raw_static=$$($(MAKE) -s --no-print-directory -C $(srcdir) BUILD=../$(build_dir) print-release-static-libs); \
	  raw_pic=$$($(MAKE) -s --no-print-directory -C $(srcdir) BUILD=../$(build_dir) print-release-pic-libs); \
	  test -n "$$raw_nogmp" || { echo "production STATIC_NOGMP_LIBS is empty" >&2; exit 1; }; \
	  test -n "$$raw_static" || { echo "production STATIC_LIBS is empty" >&2; exit 1; }; \
	  test -n "$$raw_pic" || { echo "production PIC_LIBS is empty" >&2; exit 1; }; \
	  production_nogmp=$$(normalize_production_inputs "$$raw_nogmp"); \
	  production_static=$$(normalize_production_inputs "$$raw_static"); \
	  production_pic=$$(normalize_production_inputs "$$raw_pic"); \
	  expected_nogmp='deps/libcudd.a -lm deps/libcryptominisat5.a deps/libcadical.a deps/libkissat_yices.a -lc++ -lm'; \
	  expected_static="$$expected_nogmp deps/libpoly.a deps/libgmp-static.a"; \
	  expected_pic="$$expected_nogmp deps/libpicpoly.a $$dylib_gmp"; \
	  test "$$production_nogmp" = "$$expected_nogmp" || { \
	    echo "unexpected normalized macOS STATIC_NOGMP_LIBS: $$production_nogmp" >&2; exit 1; \
	  }; \
	  test "$$production_static" = "$$expected_static" || { \
	    echo "unexpected normalized macOS STATIC_LIBS: $$production_static" >&2; exit 1; \
	  }; \
	  test "$$production_pic" = "$$expected_pic" || { \
	    echo "unexpected normalized macOS PIC_LIBS: $$production_pic" >&2; exit 1; \
	  }; \
	  ar_version=$$($(AR) -V 2>&1 | head -1); \
	  case "$$ar_version" in \
	    ""|usage:*|Usage:*|ar:\ *) ar_version=version-unavailable ;; \
	  esac; \
	  { \
	    printf '%s\n' '# Yices macOS relink-kit build record'; \
	    printf 'yices-version: %s\n' '$(YICES_VERSION)'; \
	    printf 'yices-commit: %s\n' "$$revision"; \
	    printf 'yices-branch: %s\n' "$$branch"; \
	    printf 'artifact: %s\n' "$$artifact"; \
	    printf 'artifact-sha256: %s\n' "$$artifact_sha"; \
	    printf 'kit-built: %s\n' "$$(date -u +%Y-%m-%dT%H:%M:%SZ)"; \
	    printf 'target-triple: %s\n' '$(ARCH)'; \
	    printf 'build-host-os: %s\n' "$$(sw_vers -productName) $$(sw_vers -productVersion)"; \
	    printf 'thread-safe: no\n'; \
	    printf 'yices-mode: release\n'; \
	    printf 'builder-image: NOT-APPLICABLE, native macOS build\n'; \
	    printf 'builder-image-digest: NOT-APPLICABLE, native macOS build\n'; \
	    printf 'builder-base-image: NOT-APPLICABLE, native macOS build\n'; \
	    printf 'cc: %s\n' '$(CC)'; \
	    printf 'cc-version: %s\n' "$$($(CC) --version 2>/dev/null | head -1)"; \
	    printf 'ld-version: %s\n' "$$($(LD) -v 2>&1 | head -1)"; \
	    printf 'ar-version: %s\n' "$$ar_version"; \
	    printf 'sdk-path: %s\n' "$$(xcrun --show-sdk-path)"; \
	    printf 'sdk-version: %s\n' "$$(get_prov sdk-version)"; \
	    printf 'manual-pdf-sha256: %s\n' "$$(get_prov manual-pdf-sha256)"; \
	    printf 'manual-build-host-os: %s\n' "$$(get_prov manual-build-host-os)"; \
	    printf 'manual-latexmk-version: %s\n' "$$(get_prov manual-latexmk-version)"; \
	    printf 'manual-pdflatex-version: %s\n' "$$(get_prov manual-pdflatex-version)"; \
	    printf 'deployment-target: 11.0\n'; \
	    printf 'cxx-runtime: -lc++\n'; \
	    printf 'cflags: %s\n' '$(macos_release_cflags)'; \
	    printf 'dependency-archive-count: %s\n' "$$archive_count"; \
	    printf 'gmp-layout: %s\n' "$$gmp_layout"; \
	    printf 'link-yices: %s\n' "MACOSX_DEPLOYMENT_TARGET=11.0 $(CC) $(macos_release_cflags) -o yices executables/yices.o deps/libyices.a $$production_static"; \
	    printf 'link-yices-smt: %s\n' "MACOSX_DEPLOYMENT_TARGET=11.0 $(CC) $(macos_release_cflags) -o yices-smt executables/yices_smtcomp.o deps/libyices.a $$production_static"; \
	    printf 'link-yices-smt2: %s\n' "MACOSX_DEPLOYMENT_TARGET=11.0 $(CC) $(macos_release_cflags) -o yices-smt2 executables/yices_smt2.o deps/libyices.a $$production_static"; \
	    printf 'link-yices-sat: %s\n' "MACOSX_DEPLOYMENT_TARGET=11.0 $(CC) $(macos_release_cflags) -o yices-sat executables/yices_sat.o deps/libyices.a $$production_nogmp"; \
	    printf 'link-libyices-dylib: %s\n' "MACOSX_DEPLOYMENT_TARGET=11.0 $(CC) $(macos_release_cflags) -dynamiclib -current_version 2.8.0 -compatibility_version 2.8.0 -Wl,-install_name,@rpath/libyices.2.dylib -Wl,-headerpad_max_install_names -Wl,-dead_strip -Wl,-force_load,deps/libyices-dylib.a -o libyices.2.dylib $$production_pic"; \
	    printf 'gmp-version: %s\n' "$$(get_prov gmp-version)"; \
	    printf 'gmp-source-asset: %s\n' "$$(get_prov gmp-source-file)"; \
	    printf 'gmp-source-sha256: %s\n' "$$(get_prov gmp-source-sha256)"; \
	    printf 'gmp-build-platform: %s\n' "$$(get_prov gmp-build-platform)"; \
	    printf 'gmp-build-arch: %s\n' "$$(get_prov gmp-build-arch)"; \
	    printf 'gmp-deployment-target: %s\n' "$$(get_prov gmp-deployment-target)"; \
	    printf 'gmp-cc: %s\n' "$$(get_prov gmp-cc)"; \
	    printf 'gmp-cc-version: %s\n' "$$(get_prov gmp-cc-version)"; \
	    printf 'gmp-cxx: %s\n' "$$(get_prov gmp-cxx)"; \
	    printf 'gmp-cxx-version: %s\n' "$$(get_prov gmp-cxx-version)"; \
	    printf 'gmp-normal-configure-args: %s\n' "$$(get_prov gmp-normal-configure-args)"; \
	    printf 'gmp-normal-cflags: %s\n' "$$(get_prov gmp-normal-cflags)"; \
	    printf 'gmp-normal-cxxflags: %s\n' "$$(get_prov gmp-normal-cxxflags)"; \
	    printf 'gmp-normal-tests: %s\n' "$$(get_prov gmp-normal-tests)"; \
	    printf 'gmp-pic-configure-args: %s\n' "$$(get_prov gmp-pic-configure-args)"; \
	    printf 'gmp-pic-cflags: %s\n' "$$(get_prov gmp-pic-cflags)"; \
	    printf 'gmp-pic-cxxflags: %s\n' "$$(get_prov gmp-pic-cxxflags)"; \
	    printf 'gmp-pic-tests: %s\n' "$$(get_prov gmp-pic-tests)"; \
	    printf 'gmp-static-archive-sha256: %s\n' "$$(get_prov gmp-static-archive-sha256)"; \
	    printf 'gmp-pic-archive-sha256: %s\n' "$$(get_prov gmp-pic-archive-sha256)"; \
	    printf 'gmp-normal-header-file: %s\n' "$$(get_prov gmp-normal-header-file)"; \
	    printf 'gmp-normal-header-sha256: %s\n' "$$(get_prov gmp-normal-header-sha256)"; \
	    printf 'gmp-pic-header-file: %s\n' "$$(get_prov gmp-pic-header-file)"; \
	    printf 'gmp-pic-header-sha256: %s\n' "$$(get_prov gmp-pic-header-sha256)"; \
	    printf 'gmp-license-election: LGPL-3.0-or-later\n'; \
	    printf 'libpoly-repo: %s\n' "$$(get_prov libpoly-repo)"; \
	    printf 'libpoly-commit: %s\n' "$$(get_prov libpoly-commit)"; \
	    printf 'libpoly-tree: %s\n' "$$(get_prov libpoly-tree)"; \
	    printf 'libpoly-source-asset: %s\n' "$$(get_prov libpoly-source-file)"; \
	    printf 'libpoly-source-sha256: %s\n' "$$(get_prov libpoly-source-sha256)"; \
	    printf 'libpoly-static-archive-sha256: %s\n' "$$(get_prov libpoly-static-archive-sha256)"; \
	    printf 'libpoly-pic-archive-sha256: %s\n' "$$(get_prov libpoly-pic-archive-sha256)"; \
	    printf 'libpoly-tests: %s\n' "$$(get_prov libpoly-tests)"; \
	    printf 'libpoly-header-root: %s\n' "$$(get_prov libpoly-header-root)"; \
	    printf 'libpoly-header-count: %s\n' "$$(get_prov libpoly-header-count)"; \
	    printf 'libpoly-header-manifest-sha256: %s\n' "$$(get_prov libpoly-header-manifest-sha256)"; \
	    printf 'release-inputs-file: %s\n' "$$(get_prov release-inputs-file)"; \
	    printf 'release-inputs-sha256: %s\n' "$$(get_prov release-inputs-sha256)"; \
	    for key in $(dependency_buildinfo_keys); do \
	      printf '%s: %s\n' "$$key" "$$(get_prov "$$key")"; \
	    done; \
	  } > $(relink_kit_dir)/BUILDINFO
	@ if grep -n 'GENERATED' $(relink_kit_dir)/BUILDINFO; then \
	    echo "BUILDINFO still contains an unfilled placeholder" >&2; exit 1; \
	  fi; \
	  if grep -n -E '^[A-Za-z0-9._-]+:[[:space:]]*$$' $(relink_kit_dir)/BUILDINFO; then \
	    echo "BUILDINFO contains an empty value" >&2; exit 1; \
	  fi
	@ set -eu; cd $(relink_kit_dir); \
	  list=$$(mktemp "$${TMPDIR:-/tmp}/yices-manifest-files.XXXXXX"); \
	  manifest=$$(mktemp "$${TMPDIR:-/tmp}/yices-manifest.XXXXXX"); \
	  trap 'rm -f "$$list" "$$manifest"' 0 1 2 15; \
	  find . -type f ! -name MANIFEST.sha256 -print | LC_ALL=C sort > "$$list"; \
	  : > "$$manifest"; \
	  while IFS= read -r file; do \
	    if command -v sha256sum >/dev/null 2>&1; then line=$$(sha256sum "$$file") || exit 1; \
	    else line=$$(shasum -a 256 "$$file") || exit 1; fi; \
	    hash=$${line%% *}; \
	    case "$$hash" in ''|*[!0-9a-f]*) exit 1 ;; esac; \
	    test "$${#hash}" -eq 64 || exit 1; \
	    printf '%s  %s\n' "$$hash" "$$file" >> "$$manifest"; \
	  done < "$$list"; \
	  while IFS= read -r line; do \
	    expected=$${line%%  *}; file=$${line#*  }; \
	    test "$$line" = "$$expected  $$file" || exit 1; \
	    if command -v sha256sum >/dev/null 2>&1; then actual_line=$$(sha256sum "$$file") || exit 1; \
	    else actual_line=$$(shasum -a 256 "$$file") || exit 1; fi; \
	    actual=$${actual_line%% *}; test "$$actual" = "$$expected" || exit 1; \
	  done < "$$manifest"; \
	  cp "$$manifest" MANIFEST.sha256; \
	  while IFS= read -r line; do \
	    expected=$${line%%  *}; file=$${line#*  }; \
	    test "$$line" = "$$expected  $$file" || exit 1; \
	    if command -v sha256sum >/dev/null 2>&1; then actual_line=$$(sha256sum "$$file") || exit 1; \
	    else actual_line=$$(shasum -a 256 "$$file") || exit 1; fi; \
	    actual=$${actual_line%% *}; test "$$actual" = "$$expected" || exit 1; \
	  done < MANIFEST.sha256; \
	  rm -f "$$list" "$$manifest"; \
	  trap - 0 1 2 15
	chmod -R og+rX $(relink_kit_dir)
	$(MKARCHIVE) $(distributions)/$(relink_kit_tarfile) \
	  $(relink_work_dir) $(relink_kit_name)
	chmod og+r $(distributions)/$(relink_kit_tarfile)
	@ count=$$(find $(relink_kit_dir)/deps -type f -name '*.a' -print | wc -l | tr -d ' '); \
	  echo "=== Built $(distributions)/$(relink_kit_tarfile) with $$count archives ==="

.PHONY: macos-relink-kit



#
# Install from the source.
#
# The target directories are determined by ./configure:
#   bindir = where to put binaries
#   libdir = where to put the libraries
#   includedir = where to put the include files
#
# We assume 'make binary-distribution' was done first,
# then we copy the $(dist_dir) content:
#   $(dist_dir)/bin     into $(bindir)
#   $(dist_dir)/lib     into $(libdir)
#   $(dist_dir)/include into $(includedir)
#
# Note: the default bindir, libdir, includedir are set by the
# configure script, and are imported from $(YICES_MAKE_INCLUDE).
# These defaults can be changed by using 'make install prefix=...'
#
# We also (try to) support the DESTDIR convention.
#
# The reason we don't want to force compilation in 'make install' is
# that we typically need to do 'sudo make install' but we don't want
# to compile with 'sudo make binary-distribution'.  That can easily
# fail if the source and build directory or file permissions are
# wrong, or lead to other problems.
#
install: install-$(POSIXOS)

install-default:
	@license_src='$(firstword $(wildcard LICENSE.txt LICENSE))'; \
	 notices_src='$(firstword $(wildcard etc/NOTICES NOTICES))'; \
	 test -n "$$license_src" && test -f "$$license_src" || \
	   { echo "make install: LICENSE.txt or LICENSE is required" >&2; exit 1; }; \
	 test -n "$$notices_src" && test -f "$$notices_src" || \
	   { echo "make install: etc/NOTICES or NOTICES is required" >&2; exit 1; }; \
	 test -d LICENSES || \
	   { echo "make install: LICENSES directory is required" >&2; exit 1; }; \
	 set -- LICENSES/*; test -f "$$1" || \
	   { echo "make install: LICENSES must contain regular files" >&2; exit 1; }; \
	 for legal_src in LICENSES/*; do \
	   test -f "$$legal_src" || \
	     { echo "make install: non-regular legal input: $$legal_src" >&2; exit 1; }; \
	 done
	$(MKDIR_P) $(DESTDIR)$(bindir)
	$(MKDIR_P) $(DESTDIR)$(libdir)
	$(MKDIR_P) $(DESTDIR)$(libdir)/pkgconfig
	$(MKDIR_P) $(DESTDIR)$(includedir)
	$(MKDIR_P) $(DESTDIR)$(prefix)/share/doc/yices-$(YICES_VERSION)
	$(MKDIR_P) $(DESTDIR)$(prefix)/share/licenses/yices-$(YICES_VERSION)
	$(INSTALL) -m 664 $(dist_dir)/include/* $(DESTDIR)$(includedir)
	$(INSTALL) $(dist_dir)/bin/* $(DESTDIR)$(bindir)
	$(INSTALL) $(dist_dir)/lib/* $(DESTDIR)$(libdir)
	$(INSTALL) -m 664 yices.pc $(DESTDIR)$(libdir)/pkgconfig/yices.pc
	@license_src='$(firstword $(wildcard LICENSE.txt LICENSE))'; \
	 notices_src='$(firstword $(wildcard etc/NOTICES NOTICES))'; \
	 test -n "$$license_src" || { echo "make install: LICENSE.txt or LICENSE is required" >&2; exit 1; }; \
	 test -n "$$notices_src" || { echo "make install: etc/NOTICES or NOTICES is required" >&2; exit 1; }; \
	 $(INSTALL) -m 664 "$$license_src" $(DESTDIR)$(prefix)/share/doc/yices-$(YICES_VERSION)/LICENSE; \
	 $(INSTALL) -m 664 "$$notices_src" $(DESTDIR)$(prefix)/share/doc/yices-$(YICES_VERSION)/NOTICES
	$(INSTALL) -m 664 LICENSES/* $(DESTDIR)$(prefix)/share/licenses/yices-$(YICES_VERSION)

install-darwin: install-default
	(cd $(DESTDIR)$(libdir) && $(LN_S) -f libyices.$(MAJOR).dylib libyices.dylib)

install-solaris: install-default
	$(LDCONFIG) -n $(DESTDIR)$(libdir) && (cd $(DESTDIR)$(libdir) && $(LN_S) -f libyices.so.$(YICES_VERSION) libyices.so)

# Avoid ldconfig as it's not present on musl. We create the following symlinks:
# - libyices.so.X.Y.Z -> libyices.so.X.Y
# - libyices.so.X.Y   -> libyices.so
install-linux install-unix: install-default
	(cd $(DESTDIR)$(libdir) && $(LN_S) -f libyices.so.$(YICES_VERSION) libyices.so.$(MAJOR).$(MINOR) && $(LN_S) -f libyices.so.$(MAJOR).$(MINOR) libyices.so)

# on FreeBSD: the library file is libyices.so.X.Y and ldconfig does not take -n
# FreeBSD's shared-library filename and SONAME are libyices.so.MAJOR.MINOR.
# Provide the linker name explicitly; do not point it at absent libyices.so.MAJOR.
install-freebsd: install-default
	(cd $(DESTDIR)$(libdir) && $(LN_S) -f libyices.so.$(MAJOR).$(MINOR) libyices.so)

install-netbsd: install-default
	(cd $(DESTDIR)$(libdir) && $(LN_S) -f libyices.so.$(YICES_VERSION) libyices.so)

#
# cygwin and mingw install: copy the DLLs in $(bindir)
#
install-cygwin: $(build_dir) $(dist_dir)
	@license_src='$(firstword $(wildcard LICENSE.txt LICENSE))'; \
	 notices_src='$(firstword $(wildcard etc/NOTICES NOTICES))'; \
	 test -n "$$license_src" && test -f "$$license_src" || \
	   { echo "make install: LICENSE.txt or LICENSE is required" >&2; exit 1; }; \
	 test -n "$$notices_src" && test -f "$$notices_src" || \
	   { echo "make install: etc/NOTICES or NOTICES is required" >&2; exit 1; }; \
	 test -d LICENSES || \
	   { echo "make install: LICENSES directory is required" >&2; exit 1; }; \
	 set -- LICENSES/*; test -f "$$1" || \
	   { echo "make install: LICENSES must contain regular files" >&2; exit 1; }; \
	 for legal_src in LICENSES/*; do \
	   test -f "$$legal_src" || \
	     { echo "make install: non-regular legal input: $$legal_src" >&2; exit 1; }; \
	 done
	$(MKDIR_P) $(DESTDIR)$(bindir)
	$(MKDIR_P) $(DESTDIR)$(libdir)
	$(MKDIR_P) $(DESTDIR)$(libdir)/pkgconfig
	$(MKDIR_P) $(DESTDIR)$(includedir)
	$(MKDIR_P) $(DESTDIR)$(prefix)/share/doc/yices-$(YICES_VERSION)
	$(MKDIR_P) $(DESTDIR)$(prefix)/share/licenses/yices-$(YICES_VERSION)
	$(INSTALL) -m 664 $(dist_dir)/include/* $(DESTDIR)$(includedir)
	$(INSTALL) $(dist_dir)/bin/* $(DESTDIR)$(bindir)
	$(INSTALL) $(dist_dir)/lib/*.a $(DESTDIR)$(libdir)
	$(INSTALL) -m 664 yices.pc $(DESTDIR)$(libdir)/pkgconfig/yices.pc
	@license_src='$(firstword $(wildcard LICENSE.txt LICENSE))'; \
	 notices_src='$(firstword $(wildcard etc/NOTICES NOTICES))'; \
	 $(INSTALL) -m 664 "$$license_src" $(DESTDIR)$(prefix)/share/doc/yices-$(YICES_VERSION)/LICENSE; \
	 $(INSTALL) -m 664 "$$notices_src" $(DESTDIR)$(prefix)/share/doc/yices-$(YICES_VERSION)/NOTICES
	$(INSTALL) -m 664 LICENSES/* $(DESTDIR)$(prefix)/share/licenses/yices-$(YICES_VERSION)

install-mingw: install-cygwin


.PHONY: install install-default install-darwin install-solaris \
	install-linux install-freebsd install-netbsd install-unix \
        install-cygwin install-mingw



#
# SOURCE DISTRIBUTION
#
srcdist_dir = yices-$(YICES_VERSION)
srcdist_tarfile= yices-$(YICES_VERSION)-src.tar.gz

#
# Build the source tar file
#
# NOTE: chmod -R .. may fail on some Solaris versions
# - a workaround is to use a GNU/fileutils version of chmod
#   instead of SUN's own version
# - on CSL ungoliant: make sure /csl/bin is in the path before /bin
#   and /usr/bin
#
# For tests: we copy all unit tests and the regression tests in
# arrays/bv/efsmt/mantis/wd.
#
source-distribution: $(distributions) doc
	@ echo "=== Building $(srcdist_tarfile) ==="
	@ test -s doc/manual/manual.pdf && test doc/manual/manual.pdf -nt doc/manual/manual.tex || \
	  { echo "ERROR: doc/manual/manual.pdf is missing or older than doc/manual/manual.tex" >&2; exit 1; }
	rm -f -r $(srcdist_dir)
	$(MKDIR_P) $(srcdist_dir)
	cp install-sh config.guess configure configure.ac config.sub gmaketest yices.pc.in \
	  RELINKING.md $(srcdist_dir)
	cp Makefile Makefile.build make.include.in $(srcdist_dir)
	$(MKDIR_P) $(srcdist_dir)/autoconf
	cp autoconf/* $(srcdist_dir)/autoconf
	$(MKDIR_P) $(srcdist_dir)/scripts
	cp scripts/rewrite-kissat-kitten-symbols.sh scripts/capture-release-provenance.sh \
	  scripts/create-release-archive.sh scripts/delegate-build-metadata.py \
	  $(srcdist_dir)/scripts
	$(MKDIR_P) $(srcdist_dir)/configs
	$(MKDIR_P) $(srcdist_dir)/etc
	cp etc/README.source $(srcdist_dir)/README
	cp etc/NOTICES $(srcdist_dir)
	cp LICENSE.txt $(srcdist_dir)/LICENSE
	for file in etc/* ; do \
	  if test -f "$$file" && test "$$file" != etc/NOTICES ; then \
	    cp "$$file" $(srcdist_dir)/etc ; \
	  fi ; \
	done
	cp -R etc/relink $(srcdist_dir)/etc
	cp -R LICENSES $(srcdist_dir)
	$(MKDIR_P) $(srcdist_dir)/src
	# Version sources are transient build outputs, regenerated by the recipient.
	rsync -R `find src/ \( -name "Makefile" -o -name "*.c" -o -name "*.h" -o -name "*.txt" \) ! -name 'yices_*_version.c'` $(srcdist_dir)
	$(MKDIR_P) $(srcdist_dir)/doc
	$(MKDIR_P) $(srcdist_dir)/doc/manual
	cp doc/COMPILING doc/NOTES doc/YICES-LANGUAGE doc/GMP doc/manual/manual.pdf \
           $(srcdist_dir)/doc
	cp doc/manual/*.pdf doc/manual/*.tex doc/manual/*.bib \
           doc/manual/*.cls doc/manual/*.sty doc/manual/*.eps doc/manual/*.fig \
	   $(srcdist_dir)/doc/manual
	$(MKDIR_P) $(srcdist_dir)/utils
	cp utils/gmp-hack.h utils/mingw-build utils/setup-vs2010 utils/setup-vs2013 \
	   utils/yices_parser.txt utils/yices_input_tables.h \
	   utils/smt_parser.txt utils/smt_input_tables.h \
	   utils/smt2_parser.txt utils/smt2_input_tables.h \
	   utils/table_builder.c utils/truth_table_compiler.c \
	   utils/mkreadme utils/mkreadme-android utils/make_source_version \
	   utils/lib_name utils/gmp_version utils/yices_version \
           utils/remove_trailing_whitespaces \
           $(srcdist_dir)/utils
	$(MKDIR_P) $(srcdist_dir)/examples
	for file in `ls examples | $(EGREP) '\.ys$$|\.smt$$|\.c$$|\.smt2$$|\.cpp$$' ` ; do \
	  cp examples/$$file $(srcdist_dir)/examples ; \
	done || true
	$(MKDIR_P) $(srcdist_dir)/tests
	cp -R tests/unit $(srcdist_dir)/tests
	cp -R tests/api $(srcdist_dir)/tests
	find $(srcdist_dir)/tests/api -type f -name '*.log' -delete
	$(MKDIR_P) $(srcdist_dir)/tests/regress
	for t in regress/arrays regress/bv regress/efsmt regress/mantis regress/wd ; do \
	   cp -R tests/$$t $(srcdist_dir)/tests/regress ; \
	done
	cp tests/regress/check.sh tests/regress/run_test.sh $(srcdist_dir)/tests/regress
	chmod -R og+rX $(srcdist_dir)
	$(MKARCHIVE) $(distributions)/$(srcdist_tarfile) . $(srcdist_dir)
	chmod -R og+rX $(distributions)
	rm -f -r $(srcdist_dir)

.PHONY: source-distribution


#
# Aggregate release-package targets
#
# Invoke the overlapping archive targets in one make dependency graph so
# shared prerequisites such as static-tarfile and release-provenance run once.
# The global .NOTPARALLEL guard at the end of this file serializes the graph.
#
release-package: static-distribution source-distribution relink-kit

macos-release-package: static-distribution macos-relink-kit

.PHONY: release-package macos-release-package



#
# CLEANUP
#

#
# Basic clean: delete build sub-directories for architecture + mode
#
clean:
	rm -rf $(build_dir)/*

#
# Arch clean: delete all build subdirectories for an architecture
#
arch-clean:
	rm -rf build/$(ARCH)-*

#
# All clean delete all build directories
# - also clean the src directory
#
all-clean:
	rm -rf build/*
	$(MAKE) -C $(srcdir) clean

.PHONY: clean arch-clean all-clean



#
# Helper rule for debugging Makefiles and configure
#
show-details:
	@ echo
	@ echo "*** Recursive Makefile ***"
	@ echo
	@ echo "target is $@"
	@ echo
	@ echo "ARCH is $(ARCH)"
	@ echo "POSIXOS is $(POSIXOS)"
	@ echo "YICES_TOP_DIR is $(YICES_TOP_DIR)"
	@ echo "YICES_MAKE_INCLUDE is $(YICES_MAKE_INCLUDE)"
	@ echo "YICES_MODE is $(YICES_MODE)"
	@ echo "YICES_VERSION is $(YICES_VERSION)"
	@ echo "MAJOR is $(MAJOR)"
	@ echo "MINOR is $(MINOR)"
	@ echo "PATCH_LEVEL is $(PATCH_LEVEL)"
	@ echo
	@ echo "Configuration"
	@ echo "  EXEEXT   = $(EXEEXT)"
	@ echo "  SED      = $(SED)"
	@ echo "  LN_S     = $(LN_S)"
	@ echo "  MKDIR_P  = $(MKDIR_P)"
	@ echo "  CC       = $(CC)"
	@ echo "  CPPFLAGS = $(CPPFLAGS)"
	@ echo "  CFLAGS   = $(CFLAGS)"
	@ echo "  LIBS     = $(LIBS)"
	@ echo "  LDFLAGS  = $(LDFLAGS)"
	@ echo "  LD       = $(LD)"
	@ echo "  AR       = $(AR)"
	@ echo "  RANLIB   = $(RANLIB)"
	@ echo "  GPERF    = $(GPERF)"
	@ echo "  STRIP    = $(STRIP)"
	@ echo
	@ echo "  NO_STACK_PROTECTOR = $(NO_STACK_PROTECTOR)"
	@ echo
	@ echo "  STATIC_GMP = $(STATIC_GMP)"
	@ echo "  STATIC_GMP_INCLUDE_DIR = $(STATIC_GMP_INCLUDE_DIR)"
	@ echo
	@ echo "  PIC_GMP = $(PIC_GMP)"
	@ echo "  PIC_GMP_INCLUDE_DIR = $(PIC_GMP_INCLUDE_DIR)"
	@ echo
	@ echo "  ENABLE_MCSAT = $(ENABLE_MCSAT)"
	@ echo
	@ echo "  STATIC_LIBPOLY = $(STATIC_LIBPOLY)"
	@ echo "  STATIC_LIBPOLY_INCLUDE_DIR = $(STATIC_LIBPOLY_INCLUDE_DIR)"
	@ echo
	@ echo "  PIC_LIBPOLY = $(PIC_LIBPOLY)"
	@ echo "  PIC_LIBPOLY_INCLUDE_DIR = $(PIC_LIBPOLY_INCLUDE_DIR)"
	@ echo
	@ echo "  HAVE_CADICAL_DELEGATE = $(HAVE_CADICAL_DELEGATE)"
	@ echo "  HAVE_CRYPTOMINISAT_DELEGATE = $(HAVE_CRYPTOMINISAT_DELEGATE)"
	@ echo "  HAVE_KISSAT_DELEGATE = $(HAVE_KISSAT_DELEGATE)"
	@ echo "  STATIC_DEPDIR = $(STATIC_DEPDIR)"
	@ echo "  STATIC_DELEGATES_INCLUDE_DIR = $(STATIC_DELEGATES_INCLUDE_DIR)"
	@ echo "  STATIC_CADICAL_RAW = $(STATIC_CADICAL_RAW)"
	@ echo "  STATIC_CRYPTOMINISAT_RAW = $(STATIC_CRYPTOMINISAT_RAW)"
	@ echo "  STATIC_KISSAT_RAW = $(STATIC_KISSAT_RAW)"
	@ echo "  STATIC_KISSAT_YICES = $(STATIC_KISSAT_YICES)"
	@ echo "  DYNAMIC_DELEGATES_ASSUME_HIDDEN_KITTEN = $(DYNAMIC_DELEGATES_ASSUME_HIDDEN_KITTEN)"
	@ echo


.PHONY: show-details


#
# Make sure everything here is serialized
# The sub makes can be run in parallel so option -j x should be allowed
#
.NOTPARALLEL:
