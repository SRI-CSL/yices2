(set-option :produce-unsat-model-interpolants true)
(set-logic QF_BV)
(declare-fun x1 () (_ BitVec 32))
(declare-fun x2 () (_ BitVec 32))
(declare-fun x3 () (_ BitVec 32))
(declare-fun z () (_ BitVec 32))
(declare-fun w () (_ BitVec 32))
(assert (or (not (bvuge x2 #x00000005)) (= x3 (bvadd x2 #x00000002))))
(assert (or (not (bvuge x1 #x00000003)) (= x2 (bvadd x1 #x00000006))))
(assert (= x1 #x00000004))
(push 1)
(assert (or (not (bvuge x3 #x00000005)) (= w (bvadd x3 x2))))
(push 1)
(check-sat-assuming-model (w) (#x00000007))
(get-unsat-model-interpolant)
(check-sat-assuming-model (z w) (#x00000007 #x00000008))
(get-unsat-model-interpolant)
(pop 1)
(check-sat-assuming-model (x3) (#x00000008))
(get-unsat-model-interpolant)
(check-sat-assuming-model (w x3) (#x00000016 #x0000000c))
