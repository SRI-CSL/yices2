(set-option :yices-c-threshold 5)
(set-option :yices-mcsat-rand-dec-freq 0.5)
(set-logic QF_LIA)
(get-option :yices-c-threshold)
(get-option :yices-mcsat-rand-dec-freq)
(declare-const x Int)
(declare-const p Bool)
(assert (> x 0))
(check-sat)
(get-option :yices-c-threshold)
(check-sat-assuming (p))
(get-option :yices-c-threshold)
(get-option :yices-mcsat-rand-dec-freq)
